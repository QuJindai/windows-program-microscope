{
  "name": "windows-program-microscope",
  "private": true,
  "version": "0.2.0",
  "description": "GUI-first Windows Program Microscope",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "test:core": "node --test tests/trace-core.test.cjs",
    "test:gui": "node tests/integration/workbench.cjs && node tests/gui/evidence.spec.cjs",
    "test": "npm run test:core && python3 -m unittest discover -s tests -v",
    "collector:publish": "dotnet publish collector/windows -c Release -r win-x64 --self-contained true -o src-tauri/collector",
    "build:windows": "npm run collector:publish && tauri build"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.8.0",
    "playwright": "1.62.1"
  }
}
