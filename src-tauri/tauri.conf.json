{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Program Microscope",
  "version": "0.1.0",
  "identifier": "com.qujindai.program-microscope",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Program Microscope",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "windows": {
      "webviewInstallMode": {"type": "downloadBootstrapper"}
    }
  }
}

